{% extends "base.twig" %}

{% block title %}Contato – AR Mooring Solutions{% endblock %}

{% block content %}
<section class="bg-gray-50 pb-16 sm:pb-24">

    <div class="bg-[#00151a] w-full py-16 sm:py-24 text-center" data-aos="fade-in">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <h1 class="text-3xl sm:text-4xl font-bold text-white">Entre em Contato</h1>
            <p class="mt-4 max-w-2xl mx-auto text-lg text-gray-300">
                Estamos prontos para atender suas demandas. Nossos canais estão abertos 24/7 para suporte operacional.
            </p>
        </div>
    </div>

    <div class="bg-gray-50 py-16 sm:py-20">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
                
                <div class="bg-white p-8" data-aos="fade-up">
                    <h3 class="text-2xl font-bold text-gray-900 mb-6">Informações de Contato</h3>
                    <div class="space-y-4 text-gray-700">
                        <div class="flex items-start gap-4">
                            <i class="fa-solid fa-location-dot text-blue-600 text-xl mt-1 w-6 text-center"></i>
                            <span>Av. Elias Agostinho, 340 - Sala 506, Imbetiba, Macaé - RJ, CEP 27.913-350</span>
                        </div>
                        <div class="flex items-center gap-4">
                            <i class="fa-solid fa-phone text-blue-600 text-xl w-6 text-center"></i>
                            <span>+55 (22) 2021-8517</span>
                        </div>
                        <div class="flex items-center gap-4">
                            <i class="fa-solid fa-envelope text-blue-600 text-xl w-6 text-center"></i>
                            <span>contato@armooringsolutions.com.br</span>
                        </div>
                    </div>
                </div>

                <div class="bg-white  p-8" data-aos="fade-up" data-aos-delay="100">
                    <h3 class="text-2xl font-bold text-gray-900 mb-6">Atendimento</h3>
                    <div class="space-y-4">
                        <div class="flex items-center gap-4">
                            <i class="fa-solid fa-clock text-blue-600 text-2xl w-8 text-center"></i>
                            <div>
                                <h4 class="font-semibold text-gray-800">Suporte Técnico e Operacional</h4>
                                <p class="text-gray-600">24 horas por dia, 7 dias por semana</p>
                            </div>
                        </div>
                        <div class="flex items-center gap-4">
                            <i class="fa-solid fa-building text-blue-600 text-2xl w-8 text-center"></i>
                            <div>
                                <h4 class="font-semibold text-gray-800">Escritório</h4>
                                <p class="text-gray-600">Segunda a Sexta: 08:00 – 18:00</p>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="bg-white  p-8" data-aos="fade-up" data-aos-delay="200">
                    <h3 class="text-2xl font-bold text-gray-900 mb-6">Siga-nos</h3>
                    <div class="flex flex-col gap-4">
                        <a href="https://www.facebook.com/armooringsolutions/" target="_blank" rel="noopener noreferrer" 
                           class="group flex items-center p-4 rounded-lg border border-gray-200 bg-gray-50 hover:border-blue-500 hover:bg-blue-50 transition-all duration-300">
                            <i class="fab fa-facebook text-3xl text-blue-600 w-8 text-center"></i>
                            <div class="ml-4">
                                <p class="font-semibold text-gray-800 group-hover:text-blue-700">Facebook</p>
                                <p class="text-sm text-gray-600">Veja nossas atualizações e fotos.</p>
                            </div>
                        </a>
                        <a href="https://br.linkedin.com/company/a-r-mooring-solutions" target="_blank" rel="noopener noreferrer" 
                           class="group flex items-center p-4 rounded-lg border border-gray-200 bg-gray-50 hover:border-blue-500 hover:bg-blue-50 transition-all duration-300">
                            <i class="fab fa-linkedin text-3xl text-blue-600 w-8 text-center"></i>
                            <div class="ml-4">
                                <p class="font-semibold text-gray-800 group-hover:text-blue-700">LinkedIn</p>
                                <p class="text-sm text-gray-600">Conecte-se com nossa rede profissional.</p>
                            </div>
                        </a>
                    </div>
                </div>

            </div>
        </div>
    </div>

    <div class="w-full" data-aos="fade-in">
        <iframe src="https://maps.google.com/maps?q=Av.%20Elias%20Agostinho%2C%20340%20-%20Sala%20506%2C%20Imbetiba%2C%20Macaé%20-%20RJ&t=&z=15&ie=UTF8&iwloc=&output=embed" 
                width="100%" 
                height="500" 
                style="border:0;" 
                allowfullscreen="" 
                loading="lazy" 
                referrerpolicy="no-referrer-when-downgrade">
        </iframe>
    </div>

</section>
{% endblock %}