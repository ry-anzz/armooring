</div>

{# ========================= MODAL - ESTICADORES ========================= #}
<div x-show="modal==='esticadores'" x-transition @keydown.escape.window="modal=null" @click.self="modal=null" class="fixed inset-0 bg-black/60 flex items-center justify-center z-50 p-4">
  <div class="bg-white rounded-2xl max-w-3xl w-full relative overflow-hidden">
    <button @click="modal=null" class="absolute top-3 right-3 text-gray-500 hover:text-gray-800 z-10">
