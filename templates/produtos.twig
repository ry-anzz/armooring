{% extends "base.twig" %}

{% block title %}Produtos – AR Mooring Solutions{% endblock %}

{% block content %}
<section class="relative bg-gray-50">

    {# HERO #}
    <div class="relative bg-[#00151a] text-white py-16 sm:py-24 px-6 sm:px-12 lg:px-24">
        <div class="max-w-6xl mx-auto text-center" data-aos="fade-up">
            <h1 class="text-3xl sm:text-5xl font-extrabold leading-tight mb-4">Produtos</h1>
            <p class="text-base sm:text-xl leading-relaxed opacity-95">
                Inovação e Qualidade para Suas Operações Marítimas e Logísticas
            </p>
        </div>
    </div>

    {# FILTRO E GRID DE PRODUTOS #}
    <div class="max-w-7xl mx-auto px-6 sm:px-12 lg:px-24 py-16" x-data="{ filtro: 'todos', modal: null }">
        <div class="flex justify-center mb-10">
            <select x-model="filtro" class="px-4 py-2 border rounded-lg text-gray-700 focus:outline-none focus:ring focus:border-blue-500 bg-white shadow-sm">
                <option value="todos">Todas as Categorias</option>
                <option value="cabos">Cabos de Aço</option>
                <option value="lingas">Linga de Cabo</option>
                <option value="acessorios">Acessórios</option>
                <option value="dispositivos_amarração">Dispositivos de Amarração</option>
                <option value="dispositivos_variados">Dispositivos Variados</option>
                <option value="manilhas">Manilhas</option>
                <option value="esticadores">Esticadores</option>
                <option value="soquetes">Soquetes</option>
                <option value="correntes">Correntes</option>
                <option value="atracacao_fundeio">Atracação e Fundeio</option>
                <option value="cordas">Cordas</option>
                <option value="redes">Redes de Carga</option>
                <option value="cintas_poliester">Cintas de Poliéster</option>
            </select>
        </div>

        {# GRID DE CARDS MODIFICADO #}
        <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-8">

            {# CABOS #}
            <div x-show="filtro==='todos' || filtro==='cabos'" @click="modal='cabos'" class="relative group cursor-pointer aspect-square  overflow-hidden shadow-lg hover:-translate-y-1 hover:shadow-2xl transition-all">
                <div class="absolute inset-0 bg-cover bg-center transition-transform duration-500 group-hover:scale-105" style="background-image: url('/assets/cabo.png')"></div>
                <div class="absolute inset-0 w-full h-full bg-black/50 text-white p-6 flex flex-col justify-end text-left transition-all duration-500 group-hover:bg-black/70">
                    <h3 class="font-bold text-lg text-white mb-2">Cabos de Aço</h3>
                    <p class="text-sm text-white/80">Alta resistência e durabilidade para ambientes marítimos.</p>
                </div>
            </div>

            {# LINGAS #}
            <div x-show="filtro==='todos' || filtro==='lingas'" @click="modal='lingas'" class="relative group cursor-pointer aspect-square  overflow-hidden shadow-lg hover:-translate-y-1 hover:shadow-2xl transition-all">
                <div class="absolute inset-0 bg-cover bg-center transition-transform duration-500 group-hover:scale-105" style="background-image: url('/assets/eslinga.png')"></div>
                <div class="absolute inset-0 w-full h-full bg-black/50 text-white p-6 flex flex-col justify-end text-left transition-all duration-500 group-hover:bg-black/70">
                    <h3 class="font-bold text-lg text-white mb-2">Linga de Cabo</h3>
                    <p class="text-sm text-white/80">Montagens certificadas para içamento seguro e eficiente.</p>
                </div>
            </div>

            {# ACESSÓRIOS #}
            <div x-show="filtro==='todos' || filtro==='acessorios'" @click="modal='acessorios'" class="relative group cursor-pointer aspect-square  overflow-hidden shadow-lg hover:-translate-y-1 hover:shadow-2xl transition-all">
                <div class="absolute inset-0 bg-cover bg-center transition-transform duration-500 group-hover:scale-105" style="background-image: url('/assets/acessorios.png')"></div>
                <div class="absolute inset-0 w-full h-full bg-black/50 text-white p-6 flex flex-col justify-end text-left transition-all duration-500 group-hover:bg-black/70">
                    <h3 class="font-bold text-lg text-white mb-2">Acessórios para Cabos</h3>
                    <p class="text-sm text-white/80">Componentes essenciais para garantir segurança e confiabilidade.</p>
                </div>
            </div>

            {# DISPOSITIVOS DE AMARRAÇÃO #}
            <div x-show="filtro==='todos' || filtro==='dispositivos_amarração'" @click="modal='dispositivos_amarração'" class="relative group cursor-pointer aspect-square  overflow-hidden shadow-lg hover:-translate-y-1 hover:shadow-2xl transition-all">
                <div class="absolute inset-0 bg-cover bg-center transition-transform duration-500 group-hover:scale-105" style="background-image: url('/assets/amarracao.png')"></div>
                <div class="absolute inset-0 w-full h-full bg-black/50 text-white p-6 flex flex-col justify-end text-left transition-all duration-500 group-hover:bg-black/70">
                    <h3 class="font-bold text-lg text-white mb-2">Dispositivos de Amarração</h3>
                    <p class="text-sm text-white/80">Fixadores robustos para estruturas marítimas e embarcações.</p>
                </div>
            </div>

            {# DISPOSITIVOS VARIADOS #}
            <div x-show="filtro==='todos' || filtro==='dispositivos_variados'" @click="modal='dispositivos_variados'" class="relative group cursor-pointer aspect-square  overflow-hidden shadow-lg hover:-translate-y-1 hover:shadow-2xl transition-all">
                <div class="absolute inset-0 bg-cover bg-center transition-transform duration-500 group-hover:scale-105" style="background-image: url('/assets/variados.png')"></div>
                <div class="absolute inset-0 w-full h-full bg-black/50 text-white p-6 flex flex-col justify-end text-left transition-all duration-500 group-hover:bg-black/70">
                    <h3 class="font-bold text-lg text-white mb-2">Dispositivos Variados</h3>
                    <p class="text-sm text-white/80">Equipamentos auxiliares para operações de carga e segurança.</p>
                </div>
            </div>

            {# MANILHAS #}
            <div x-show="filtro==='todos' || filtro==='manilhas'" @click="modal='manilhas'" class="relative group cursor-pointer aspect-square overflow-hidden shadow-lg hover:-translate-y-1 hover:shadow-2xl transition-all">
                <div class="absolute inset-0 bg-cover bg-center transition-transform duration-500 group-hover:scale-105" style="background-image: url('/assets/manilhas.png')"></div>
                <div class="absolute inset-0 w-full h-full bg-black/50 text-white p-6 flex flex-col justify-end text-left transition-all duration-500 group-hover:bg-black/70">
                    <h3 class="font-bold text-lg text-white mb-2">Manilhas</h3>
                    <p class="text-sm text-white/80">Conectores certificados para ambientes marítimos e industriais.</p>
                </div>
            </div>

            {# ESTICADORES #}
            <div x-show="filtro==='todos' || filtro==='esticadores'" @click="modal='esticadores'" class="relative group cursor-pointer aspect-square  overflow-hidden shadow-lg hover:-translate-y-1 hover:shadow-2xl transition-all">
                <div class="absolute inset-0 bg-cover bg-center transition-transform duration-500 group-hover:scale-105" style="background-image: url('/assets/esticadores.png')"></div>
                <div class="absolute inset-0 w-full h-full bg-black/50 text-white p-6 flex flex-col justify-end text-left transition-all duration-500 group-hover:bg-black/70">
                    <h3 class="font-bold text-lg text-white mb-2">Esticadores</h3>
                    <p class="text-sm text-white/80">Ajuste preciso de tensão em sistemas de amarração offshore.</p>
                </div>
            </div>

            {# SOQUETES #}
            <div x-show="filtro==='todos' || filtro==='soquetes'" @click="modal='soquetes'" class="relative group cursor-pointer aspect-square  overflow-hidden shadow-lg hover:-translate-y-1 hover:shadow-2xl transition-all">
                <div class="absolute inset-0 bg-cover bg-center transition-transform duration-500 group-hover:scale-105" style="background-image: url('/assets/soquetes.png')"></div>
                <div class="absolute inset-0 w-full h-full bg-black/50 text-white p-6 flex flex-col justify-end text-left transition-all duration-500 group-hover:bg-black/70">
                    <h3 class="font-bold text-lg text-white mb-2">Soquetes</h3>
                    <p class="text-sm text-white/80">Terminação segura para cabos em sistemas de içamento.</p>
                </div>
            </div>

            {# CORRENTES #}
            <div x-show="filtro==='todos' || filtro==='correntes'" @click="modal='correntes'" class="relative group cursor-pointer aspect-square  overflow-hidden shadow-lg hover:-translate-y-1 hover:shadow-2xl transition-all">
                <div class="absolute inset-0 bg-cover bg-center transition-transform duration-500 group-hover:scale-105" style="background-image: url('/assets/correntes.png')"></div>
                <div class="absolute inset-0 w-full h-full bg-black/50 text-white p-6 flex flex-col justify-end text-left transition-all duration-500 group-hover:bg-black/70">
                    <h3 class="font-bold text-lg text-white mb-2">Correntes</h3>
                    <p class="text-sm text-white/80">Fundamentais para fundeio, sinalização e movimentação de cargas.</p>
                </div>
            </div>

            {# ATRACAÇÃO E FUNDEIO #}
            <div x-show="filtro==='todos' || filtro==='atracacao_fundeio'" @click="modal='atracacao_fundeio'" class="relative group cursor-pointer aspect-square  overflow-hidden shadow-lg hover:-translate-y-1 hover:shadow-2xl transition-all">
                <div class="absolute inset-0 bg-cover bg-center transition-transform duration-500 group-hover:scale-105" style="background-image: url('/assets/atracacao.png')"></div>
                <div class="absolute inset-0 w-full h-full bg-black/50 text-white p-6 flex flex-col justify-end text-left transition-all duration-500 group-hover:bg-black/70">
                    <h3 class="font-bold text-lg text-white mb-2">Atracação e Fundeio</h3>
                    <p class="text-sm text-white/80">Soluções completas para operações marítimas e offshore.</p>
                </div>
            </div>

            {# CORDAS #}
            <div x-show="filtro==='todos' || filtro==='cordas'" @click="modal='cordas'" class="relative group cursor-pointer aspect-square overflow-hidden shadow-lg hover:-translate-y-1 hover:shadow-2xl transition-all">
                <div class="absolute inset-0 bg-cover bg-center transition-transform duration-500 group-hover:scale-105" style="background-image: url('/assets/cordas.png')"></div>
                <div class="absolute inset-0 w-full h-full bg-black/50 text-white p-6 flex flex-col justify-end text-left transition-all duration-500 group-hover:bg-black/70">
                    <h3 class="font-bold text-lg text-white mb-2">Cordas</h3>
                    <p class="text-sm text-white/80">Amarração leve e resistente para embarcações e plataformas.</p>
                </div>
            </div>

            {# REDES DE CARGA #}
            <div x-show="filtro==='todos' || filtro==='redes'" @click="modal='redes'" class="relative group cursor-pointer aspect-square  overflow-hidden shadow-lg hover:-translate-y-1 hover:shadow-2xl transition-all">
                <div class="absolute inset-0 bg-cover bg-center transition-transform duration-500 group-hover:scale-105" style="background-image: url('/assets/redes.png')"></div>
                <div class="absolute inset-0 w-full h-full bg-black/50 text-white p-6 flex flex-col justify-end text-left transition-all duration-500 group-hover:bg-black/70">
                    <h3 class="font-bold text-lg text-white mb-2">Redes de Carga</h3>
                    <p class="text-sm text-white/80">Transporte seguro de materiais em áreas offshore.</p>
                </div>
            </div>

            {# CINTAS DE POLIÉSTER #}
            <div x-show="filtro==='todos' || filtro==='cintas_poliester'" @click="modal='cintas_poliester'" class="relative group cursor-pointer aspect-square  overflow-hidden shadow-lg hover:-translate-y-1 hover:shadow-2xl transition-all">
                <div class="absolute inset-0 bg-cover bg-center transition-transform duration-500 group-hover:scale-105" style="background-image: url('/assets/cintas.png')"></div>
                <div class="absolute inset-0 w-full h-full bg-black/50 text-white p-6 flex flex-col justify-end text-left transition-all duration-500 group-hover:bg-black/70">
                    <h3 class="font-bold text-lg text-white mb-2">Cintas de Poliéster</h3>
                    <p class="text-sm text-white/80">Içamento leve e seguro com alta resistência à abrasão.</p>
                </div>
            </div>

        </div>

         {# ========================= MODAIS COMPLETOS ========================= #}
      {# ========================= MODAL - CABOS ========================= #}
<div x-show="modal==='cabos'" x-transition @keydown.escape.window="modal=null" @click.self="modal=null" class="fixed inset-0 bg-black/60 flex items-center justify-center z-50 p-4">
  <div class="bg-white rounded-2xl max-w-3xl w-full relative overflow-hidden">
    <button @click="modal=null" class="absolute top-3 right-3 text-gray-500 hover:text-gray-800 z-10">
      <i class="fa-solid fa-xmark text-2xl"></i>
    </button>
    <img src="/assets/cabo.png" alt="Cabos de Aço" class="w-full h-52 sm:h-64 object-cover">
    <div class="p-6 sm:p-8 max-h-[75vh] overflow-y-auto">
      <h3 class="text-2xl font-bold mb-2">Cabos de Aço</h3>
      <p class="text-gray-600 mb-6">
        Alta resistência, durabilidade e desempenho em ambientes marítimos exigentes.
      </p>
      <div class="grid sm:grid-cols-2 gap-4">
        <div class="border rounded-xl p-4 hover:shadow-md transition">
          <h4 class="font-semibold text-gray-900">Cabo 6x7 (Alma Fibra ou Aço)</h4>
          <p class="text-sm text-gray-600 mt-1">Flexível e resistente, ideal para movimentações de convés.</p>
        </div>
        <div class="border rounded-xl p-4 hover:shadow-md transition">
          <h4 class="font-semibold text-gray-900">Cabo Inox AISI 316 6x19</h4>
          <p class="text-sm text-gray-600 mt-1">Alta resistência à corrosão para uso contínuo offshore.</p>
        </div>
        <div class="border rounded-xl p-4 hover:shadow-md transition">
          <h4 class="font-semibold text-gray-900">Cabo 6x19 / 6x36</h4>
          <p class="text-sm text-gray-600 mt-1">Versátil para guindastes, turcos e amarração.</p>
        </div>
        <div class="border rounded-xl p-4 hover:shadow-md transition">
          <h4 class="font-semibold text-gray-900">Cabo Compactado 8P</h4>
          <p class="text-sm text-gray-600 mt-1">Suporta cargas elevadas com menor deformação.</p>
        </div>
        <div class="border rounded-xl p-4 hover:shadow-md transition">
          <h4 class="font-semibold text-gray-900">Cabo Não Rotativo 35x7</h4>
          <p class="text-sm text-gray-600 mt-1">Içamentos verticais estáveis, sem torções.</p>
        </div>
      </div>
    </div>
  </div>
</div>

{# ========================= MODAL - LINGAS ========================= #}
<div x-show="modal==='lingas'" x-transition @keydown.escape.window="modal=null" @click.self="modal=null" class="fixed inset-0 bg-black/60 flex items-center justify-center z-50 p-4">
  <div class="bg-white rounded-2xl max-w-3xl w-full relative overflow-hidden">
    <button @click="modal=null" class="absolute top-3 right-3 text-gray-500 hover:text-gray-800 z-10">
      <i class="fa-solid fa-xmark text-2xl"></i>
    </button>
    <img src="/assets/eslinga.png" alt="Linga de Cabo" class="w-full h-52 sm:h-64 object-cover">
    <div class="p-6 sm:p-8 max-h-[75vh] overflow-y-auto">
      <h3 class="text-2xl font-bold mb-2">Linga de Cabo de Aço</h3>
      <p class="text-gray-600 mb-6">Montagens certificadas para içamento seguro e eficiente.</p>
      <div class="grid sm:grid-cols-2 gap-4">
        <div class="border rounded-xl p-4 hover:shadow-md transition">
          <h4 class="font-semibold text-gray-900">Modelos P-1 a P-9</h4>
          <p class="text-sm text-gray-600 mt-1">Configurações para múltiplos ângulos e capacidades.</p>
        </div>
        <div class="border rounded-xl p-4 hover:shadow-md transition">
          <h4 class="font-semibold text-gray-900">Linga de Pernas Múltiplas</h4>
          <p class="text-sm text-gray-600 mt-1">1 a 4 pernas com ganchos, olhais ou manilhas.</p>
        </div>
        <div class="border rounded-xl p-4 hover:shadow-md transition">
          <h4 class="font-semibold text-gray-900">Laços Portella</h4>
          <p class="text-sm text-gray-600 mt-1">Reforçados para amarrações estruturais críticas.</p>
        </div>
      </div>
    </div>
  </div>
</div>

{# ========================= MODAL - ACESSÓRIOS ========================= #}
<div x-show="modal==='acessorios'" x-transition @keydown.escape.window="modal=null" @click.self="modal=null" class="fixed inset-0 bg-black/60 flex items-center justify-center z-50 p-4">
