      <i class="fa-solid fa-xmark text-2xl"></i>
    </button>
    <img src="/assets/acessorios.png" alt="Acessórios" class="w-full h-52 sm:h-64 object-cover">
    <div class="p-6 sm:p-8 max-h-[75vh] overflow-y-auto">
      <h3 class="text-2xl font-bold mb-2">Acessórios para Cabos</h3>
      <p class="text-gray-600 mb-6">Componentes que elevam a segurança e durabilidade dos sistemas de içamento.</p>
      <div class="grid sm:grid-cols-2 gap-4">
        <div class="border rounded-xl p-4 hover:shadow-md transition">
          <h4 class="font-semibold text-gray-900">Grampos Leves/Pesados</h4>
          <p class="text-sm text-gray-600 mt-1">Fixação segura; versões zincadas e inox.</p>
        </div>
        <div class="border rounded-xl p-4 hover:shadow-md transition">
          <h4 class="font-semibold text-gray-900">Destorcedores e Olhais</h4>
          <p class="text-sm text-gray-600 mt-1">Evitam torções e facilitam o manuseio.</p>
        </div>
        <div class="border rounded-xl p-4 hover:shadow-md transition">
          <h4 class="font-semibold text-gray-900">Sapatilhas</h4>
          <p class="text-sm text-gray-600 mt-1">Proteção contra atrito; leves, pesadas, reforçadas e inox.</p>
        </div>
      </div>
    </div>
  </div>
</div>

{# ========================= MODAL - DISPOSITIVOS DE AMARRAÇÃO ========================= #}
<div x-show="modal==='dispositivos_amarração'" x-transition @keydown.escape.window="modal=null" @click.self="modal=null" class="fixed inset-0 bg-black/60 flex items-center justify-center z-50 p-4">
  <div class="bg-white rounded-2xl max-w-3xl w-full relative overflow-hidden">
    <button @click="modal=null" class="absolute top-3 right-3 text-gray-500 hover:text-gray-800 z-10">
      <i class="fa-solid fa-xmark text-2xl"></i>
    </button>
    <img src="/assets/amarracao.png" alt="Dispositivos de Amarração" class="w-full h-52 sm:h-64 object-cover">
    <div class="p-6 sm:p-8 max-h-[75vh] overflow-y-auto">
      <h3 class="text-2xl font-bold mb-2">Dispositivos de Amarração</h3>
      <p class="text-gray-600 mb-6">Fixadores robustos para estruturas marítimas e embarcações.</p>
      <div class="grid sm:grid-cols-2 gap-4">
        <div class="border rounded-xl p-4 hover:shadow-md transition">
          <h4 class="font-semibold text-gray-900">Padeye Tipo S</h4>
          <p class="text-sm text-gray-600 mt-1">Elemento soldável para pontos de ancoragem, alta resistência mecânica.</p>
        </div>
        <div class="border rounded-xl p-4 hover:shadow-md transition">
          <h4 class="font-semibold text-gray-900">Olhal Grau 8</h4>
          <p class="text-sm text-gray-600 mt-1">Suporta grandes esforços em operações críticas.</p>
        </div>
      </div>
    </div>
  </div>
</div>

{# ========================= MODAL - DISPOSITIVOS VARIADOS ========================= #}
<div x-show="modal==='dispositivos_variados'" x-transition @keydown.escape.window="modal=null" @click.self="modal=null" class="fixed inset-0 bg-black/60 flex items-center justify-center z-50 p-4">
  <div class="bg-white rounded-2xl max-w-3xl w-full relative overflow-hidden">
    <button @click="modal=null" class="absolute top-3 right-3 text-gray-500 hover:text-gray-800 z-10">
      <i class="fa-solid fa-xmark text-2xl"></i>
    </button>
    <img src="/assets/variados.png" alt="Dispositivos Variados" class="w-full h-52 sm:h-64 object-cover">
    <div class="p-6 sm:p-8 max-h-[75vh] overflow-y-auto">
      <h3 class="text-2xl font-bold mb-2">Dispositivos Variados</h3>
      <p class="text-gray-600 mb-6">Equipamentos auxiliares para operações de carga, segurança e movimentação.</p>
      <div class="grid sm:grid-cols-2 gap-4">
        <div class="border rounded-xl p-4 hover:shadow-md transition">
          <h4 class="font-semibold text-gray-900">Levantador Eletromagnético</h4>
          <p class="text-sm text-gray-600 mt-1">Movimentação de chapas metálicas com segurança e agilidade.</p>
        </div>
        <div class="border rounded-xl p-4 hover:shadow-md transition">
          <h4 class="font-semibold text-gray-900">Talhas e Tensionadores</h4>
          <p class="text-sm text-gray-600 mt-1">Ferramentas de içamento e ajuste de tensão.</p>
        </div>
      </div>
    </div>
  </div>
</div>

{# ========================= MODAL - MANILHAS ========================= #}
<div x-show="modal==='manilhas'" x-transition @keydown.escape.window="modal=null" @click.self="modal=null" class="fixed inset-0 bg-black/60 flex items-center justify-center z-50 p-4">
  <div class="bg-white rounded-2xl max-w-3xl w-full relative overflow-hidden">
    <button @click="modal=null" class="absolute top-3 right-3 text-gray-500 hover:text-gray-800 z-10">
      <i class="fa-solid fa-xmark text-2xl"></i>
