{% extends "base.twig" %}

{% block title %}Serviços – AR Mooring Solutions{% endblock %}

{% block content %}
<section class="relative bg-gray-50">

    {# HERO #}
    <div class="w-full bg-[#00151a] text-white py-16 sm:py-24">
        <div class="max-w-6xl mx-auto px-6 sm:px-12 lg:px-24 text-center" data-aos="fade-up">
            <h2 class="text-3xl lg:text-5xl font-bold mb-6 uppercase tracking-wide">
                Nossos Serviços
            </h2>
            
            <p class="max-w-3xl mx-auto text-lg leading-relaxed text-gray-200">
                Atuamos no setor naval oferecendo soluções completas em 
                <strong>engenharia, caldeiraria e apoio marítimo</strong>.   
                Nossos serviços garantem qualidade, segurança e eficiência em todas as etapas das operações.
            </p>
        </div>
    </div>

    {# LISTA DE SERVIÇOS -- SEÇÃO MODIFICADA #}
    <div x-data="{ modalOpen: null }" class="max-w-7xl mx-auto px-6 sm:px-12 lg:px-24 py-16 grid sm:grid-cols-2 lg:grid-cols-3 gap-8">

        {% set servicos = [
            {
                'id':'engenharia',
                'img':'/assets/soldagem.png',
                'icon':'fa-solid fa-wrench',
                'title':'Engenharia & Caldeiraria',
                'desc':'Reparos e construção naval sob medida para embarcações de diferentes portes.',
                'long':'Realizamos reparos estruturais e construções sob medida, empregando caldeiraria pesada e soldagem de alta qualidade. Nossa equipe segue normas técnicas rígidas para garantir durabilidade, segurança e eficiência em cada projeto, desde pequenas embarcações até grandes navios. Prestamos consultoria especializada para otimizar processos e reduzir custos operacionais.',
                'title1':'Soldagem Especializada','desc':'Utilizamos técnicas avançadas de soldagem em aço naval.',
                'title2':'Projetos Personalizados','desc':'Adaptamos soluções de engenharia conforme a necessidade do cliente.',
                'title3':'Inspeção de Qualidade','desc':'Cada projeto é rigorosamente inspecionado antes da entrega.',
                'title4':'Suporte Técnico','desc':'Oferecemos acompanhamento contínuo durante e após a execução.'
            },
            {
                'id':'ancoragem',
                'img':'/assets/ancora.png',
                'icon':'fa-solid fa-anchor',
                'title':'Ancoragem & Planos',
                'desc':'Ancoragem em águas abrigadas e elaboração de planos conforme NPCP.',
                'long':'Desenvolvemos planos de ancoragem seguindo a NPCP, garantindo total conformidade legal e segurança operacional. Instalamos e monitoramos ancoragens em águas abrigadas e profundas. Inclui treinamentos práticos para equipes e inspeções periódicas para máxima eficiência.',
                'title1':'Planejamento Completo','desc':'Estudos detalhados de posição, profundidade e segurança.',
                'title2':'Execução Segura','desc':'Equipe treinada e equipamentos de alta qualidade.',
                'title3':'Monitoramento Contínuo','desc':'Acompanhamento remoto e inspeções regulares.',
                'title4':'Consultoria Técnica','desc':'Orientações para procedimentos e emergências.'
            },
            {
                'id':'hidrojateamento',
                'img':'/assets/pintura.png',
                'icon':'fa-solid fa-droplet',
                'title':'Hidrojateamento & Pintura',
                'desc':'Proteção contra corrosão e desgaste, garantindo durabilidade às embarcações.',
                'long':'Aplicamos hidrojateamento de alta pressão e sistemas de pintura naval que aumentam a vida útil das embarcações. Nossos serviços previnem corrosão, desgaste e reduzem custos de manutenção, sempre utilizando materiais de primeira linha. Garantimos acabamento uniforme e aderência ideal da pintura.',
                'title1':'Hidrojateamento de Alta Pressão','desc':'Remove ferrugem, sujeira e antigas camadas de tinta.',
                'title2':'Proteção Anticorrosiva','desc':'Pintura e revestimentos especiais para ambientes marítimos.',
                'title3':'Redução de Custos','desc':'Manutenção preventiva para prolongar a vida útil das embarcações.',
                'title4':'Equipe Especializada','desc':'Profissionais treinados e certificados em segurança.'
            },
            {
                'id':'cabos',
                'img':'/assets/cabo.png',
                'icon':'fa-solid fa-link',
                'title':'Cabos de Aço',
                'desc':'Fornecimento, lançamento e ancoragem de cabos de aço para operações marítimas.',
                'long':'Fornecemos cabos de aço de alta resistência, essenciais em operações navais e portuárias. Inclui testes de carga, instalação e manutenção conforme padrões internacionais, garantindo segurança e confiabilidade em qualquer operação.',
                'title1':'Alta Resistência','desc':'Cabos certificados para operações marítimas críticas.',
                'title2':'Instalação Profissional','desc':'Equipe especializada para manuseio e fixação segura.',
                'title3':'Testes de Carga','desc':'Verificação de performance antes da operação.',
                'title4':'Manutenção Preventiva','desc':'Garantindo longa vida útil dos cabos e segurança.'
            },
            {
                'id':'motogeradores',
                'img':'/assets/motogeradores.png',
                'icon':'fa-solid fa-gear',
                'title':'Manutenção de Motogeradores',
                'desc':'Manutenção preventiva e corretiva em motogeradores a diesel.',
                'long':'Realizamos manutenção preventiva e corretiva em motogeradores a diesel, garantindo confiabilidade no fornecimento de energia. Trabalhamos com peças originais, testes de carga e atendimento emergencial 24/7, assegurando operação contínua e sem falhas.',
                'title1':'Preventiva e Corretiva','desc':'Evita falhas e aumenta a vida útil do equipamento.',
                'title2':'Peças Originais','desc':'Garantia de qualidade e desempenho confiável.',
                'title3':'Testes de Carga','desc':'Verificação completa após manutenção.',
                'title4':'Atendimento Emergencial','desc':'Suporte disponível 24/7 em caso de falhas.'
            },
            {
                'id':'maoobra',
                'img':'/assets/maoobra.png',
                'icon':'fa-solid fa-users',
                'title':'Mão de Obra Qualificada',
                'desc':'Terceirização de profissionais especializados para operações navais e portuárias.',
                'long':'Disponibilizamos equipes especializadas, incluindo caldeireiros, soldadores e operadores de guindaste. Nossos colaboradores são treinados conforme as normas mais rigorosas do setor naval, garantindo eficiência, segurança e qualidade em cada operação.',
                'title1':'Equipe Especializada','desc':'Profissionais treinados e certificados.',
                'title2':'Flexibilidade','desc':'Disponível para operações pontuais ou contínuas.',
                'title3':'Segurança Garantida','desc':'Procedimentos rigorosos e monitoramento constante.',
                'title4':'Qualidade Consistente','desc':'Execução precisa e conforme padrões.',
            },
            {
                'id':'equipamentos',
                'img':'/assets/equipamentos.png',
                'icon':'fa-solid fa-box',
                'title':'Equipamentos Navais',
                'desc':'Venda e aluguel de equipamentos para diferentes operações marítimas.',
                'long':'Disponibilizamos uma ampla gama de equipamentos navais para venda e locação. Trabalhamos apenas com marcas reconhecidas para garantir qualidade e confiabilidade.',
                'title1':'Diversidade','desc':'Equipamentos variados para todas as operações.',
                'title2':'Qualidade','desc':'Marcas reconhecidas e certificadas.',
                'title3':'Locação e Venda','desc':'Flexibilidade de aquisição conforme necessidade.',
                'title4':'Suporte Técnico','desc':'Orientação para operação segura e eficiente.'
            }
        ] %}

        {% for servico in servicos %}
            <div @click="modalOpen='{{ servico.id }}'"
                 class="group cursor-pointer relative aspect-square  overflow-hidden transition-all shadow-lg hover:shadow-2xl"
                 data-aos="fade-up"
                 data-aos-delay="{{ loop.index0 * 50 }}">

                <div class="absolute inset-0 bg-cover bg-center transition-transform duration-500 group-hover:scale-105" style="background-image: url('{{ servico.img }}')"></div>

                <div class="absolute inset-0 w-full h-full bg-black/50 text-white p-6 flex flex-col justify-end text-left transition-all duration-500 group-hover:bg-black/70">
                    <i class="{{ servico.icon }} text-2xl mb-3 text-white transition-transform group-hover:scale-110"></i>
                    <h3 class="font-semibold text-white text-lg mb-1 transition-colors">
                        {{ servico.title }}
                    </h3>
                    <p class="text-white/80 text-sm opacity-0 max-h-0 group-hover:opacity-100 group-hover:max-h-40 transition-all duration-500">{{ servico.desc }}</p>
                </div>
            </div>

            {# MODAL COM TEXTO MAIOR E CARDS INTERNOS #}
            <div x-show="modalOpen === '{{ servico.id }}'" @click.away="modalOpen = null" class="fixed inset-0 bg-black bg-opacity-70 flex items-center justify-center z-50 p-4" x-transition.opacity>
                <div @click.stop class="bg-gray-100 rounded-xl max-w-4xl w-full p-6 sm:p-8 relative overflow-y-auto max-h-[90vh]">
                    <button @click="modalOpen=null" class="absolute top-3 right-3 text-gray-500 hover:text-gray-800 bg-gray-200 rounded-full w-8 h-8 flex items-center justify-center">
                        <i class="fa-solid fa-xmark text-xl"></i>
                    </button>
                    <img src="{{ servico.img }}" alt="{{ servico.title }}" class="w-full h-56 sm:h-64 object-cover rounded-lg mb-6">
                    <h3 class="text-2xl sm:text-3xl font-bold text-gray-900 mb-4">{{ servico.title }}</h3>
                    <p class="text-gray-700 leading-relaxed mb-8">{{ servico.long }}</p>

                    {# Cards internos #}
                    <div class="grid sm:grid-cols-2 gap-4">
                        <div class="bg-white rounded-lg p-4 shadow">
                            <h4 class="font-semibold text-gray-800 mb-1">{{ servico.title1 }}</h4>
                            <p class="text-gray-600 text-sm">{{ servico.desc1 }}</p>
                        </div>
                        <div class="bg-white rounded-lg p-4 shadow">
                            <h4 class="font-semibold text-gray-800 mb-1">{{ servico.title2 }}</h4>
                            <p class="text-gray-600 text-sm">{{ servico.desc2 }}</p>
                        </div>
                        <div class="bg-white rounded-lg p-4 shadow">
                            <h4 class="font-semibold text-gray-800 mb-1">{{ servico.title3 }}</h4>
                            <p class="text-gray-600 text-sm">{{ servico.desc3 }}</p>
                        </div>
                        <div class="bg-white rounded-lg p-4 shadow">
                            <h4 class="font-semibold text-gray-800 mb-1">{{ servico.title4 }}</h4>
                            <p class="text-gray-600 text-sm">{{ servico.desc4 }}</p>
                        </div>
                    </div>
                </div>
            </div>
        {% endfor %}

    </div>
</section>

{# Importar Alpine.js para os modais funcionarem #}
<script src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js" defer></script>
{% endblock %}